HOST=127.0.0.1
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DATABASE=etm
DB_USERNAME=etmuser
DB_PASSWORD=etmpass
SECRET_KEY=

# Encryption key for sensitive database fields (VAPID private key, push tokens, refresh tokens).
# Any string works; a SHA-256 of it is used as the AES-256 key.
# Generate one with: dd if=/dev/random bs=32 count=1 | sha256sum
# Leave blank to disable (fields stored as plaintext — not recommended for production).
ENCRYPTION_KEY=

# CORS: set to your frontend origin in production (e.g. https://etm.example.com)
# Leave as * only for local development
ALLOWED_ORIGIN=*

# VAPID subscriber contact for browser push notifications (must be a mailto: or https: URL)
VAPID_SUBSCRIBER=mailto:you@example.com

# OIDC (leave blank to disable)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
