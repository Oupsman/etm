services:
  etm:
    image: "{{ etm_image_name }}:{{ etm_image_tag }}"
    restart: unless-stopped
    ports:
      - "{{ etm_port }}:8080"
    env_file: .env
    networks:
      - etm
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--no-check-certificate", "http://localhost:8080/api/v1/healthcheck"]
      interval: 60s
      timeout: 3s
      start_period: 20s
      retries: 3

  postgres:
    image: postgres:18.1-trixie
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ etm_db_username }}"
      POSTGRES_PASSWORD: "{{ etm_db_password }}"
      POSTGRES_DB: "{{ etm_db_name }}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - etm

networks:
  etm:
    driver: bridge

volumes:
  postgres_data:
